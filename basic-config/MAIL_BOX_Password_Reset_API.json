/*******************************************************
 * INTERNAL MAILBOX - FORGOT PASSWORD API
 * -----------------------------------------------------
 * STATIC HTML + GOOGLE APPS SCRIPT API
 *
 * USERS SPREADSHEET
 * ID:
 * 1Ud2hZGTxwIrJAWSaufgSmfb3BAyBcVXUuxG_nhvO3_0
 *
 * USERS SHEET:
 * Users
 *
 * OTP SHEET:
 * Password_Reset_OTP
 *
 * -----------------------------------------------------
 * API ACTIONS
 *
 * POST
 *
 *   action=sendResetOTP
 *
 *   action=verifyResetOTP
 *
 *   action=resetPassword
 *
 * -----------------------------------------------------
 * OTP
 *
 * 6 digits
 * 10 minute expiry
 * Maximum 5 verification attempts
 * OTP stored as SHA-256 hash
 * New OTP invalidates previous OTP
 *
 * -----------------------------------------------------
 * PASSWORD
 *
 * Password is stored using the same SHA-256
 * method used by the registration application.
 *******************************************************/


/* =====================================================
   CONFIGURATION
   ===================================================== */

const USERS_SPREADSHEET_ID =
  '1Ud2hZGTxwIrJAWSaufgSmfb3BAyBcVXUuxG_nhvO3_0';

const USERS_SHEET_NAME =
  'Users';

const OTP_SHEET_NAME =
  'Password_Reset_OTP';


/* =====================================================
   OTP CONFIGURATION
   ===================================================== */

const OTP_LENGTH =
  6;

const OTP_EXPIRY_MINUTES =
  10;

const OTP_MAX_ATTEMPTS =
  5;


/*
 * OTP sheet headers
 */

const OTP_HEADERS = [

  'Reset_ID',
  'User_ID',
  'Email_Address',
  'Recovery_Email',
  'OTP_Hash',
  'Created_Date',
  'Expiry_Date',
  'Attempts',
  'Verified',
  'Used'

];


/* =====================================================
   DO GET
   ===================================================== */

function doGet(e) {

  try {

    return jsonResponse_({

      ok: true,

      service:
        'Internal Mailbox Forgot Password API',

      status:
        'online'

    });

  }

  catch (error) {

    return jsonResponse_({

      ok: false,

      message:
        errorMessage_(error)

    });

  }

}


/* =====================================================
   DO POST
   ===================================================== */

function doPost(e) {

  try {

    if (
      !e ||
      !e.postData ||
      !e.postData.contents
    ) {

      return jsonResponse_({

        ok: false,

        message:
          'Empty API request.'

      });

    }


    let request;


    try {

      request =
        JSON.parse(
          e.postData.contents
        );

    }

    catch (parseError) {

      return jsonResponse_({

        ok: false,

        message:
          'Invalid JSON request.'

      });

    }


    const action =
      String(
        request.action || ''
      ).trim();


    /* =================================================
       SEND OTP
       ================================================= */

    if (
      action ===
      'sendResetOTP'
    ) {

      return jsonResponse_(
        sendResetOTP(
          request.data || {}
        )
      );

    }


    /* =================================================
       VERIFY OTP
       ================================================= */

    if (
      action ===
      'verifyResetOTP'
    ) {

      return jsonResponse_(
        verifyResetOTP(
          request.data || {}
        )
      );

    }


    /* =================================================
       RESET PASSWORD
       ================================================= */

    if (
      action ===
      'resetPassword'
    ) {

      return jsonResponse_(
        resetPassword(
          request.data || {}
        )
      );

    }


    return jsonResponse_({

      ok: false,

      message:
        'Invalid POST action.'

    });

  }

  catch (error) {

    return jsonResponse_({

      ok: false,

      message:
        errorMessage_(error)

    });

  }

}


/* =====================================================
   JSON RESPONSE
   ===================================================== */

function jsonResponse_(data) {

  return ContentService

    .createTextOutput(
      JSON.stringify(data)
    )

    .setMimeType(
      ContentService.MimeType.JSON
    );

}


/* =====================================================
   SEND RESET OTP
   ===================================================== */

function sendResetOTP(
  data
) {

  data =
    data || {};


  const account =
    clean_(
      data.account
    );


  const recoveryEmail =
    normalizeEmail_(
      data.recoveryEmail
    );


  if (!account) {

    throw new Error(
      'User ID or Mailbox Email is required.'
    );

  }


  if (!recoveryEmail) {

    throw new Error(
      'Recovery Email is required.'
    );

  }


  if (
    !isValidEmail_(
      recoveryEmail
    )
  ) {

    throw new Error(
      'Please enter a valid Recovery Email address.'
    );

  }


  /* ===================================================
     LOCK
     =================================================== */

  const lock =
    LockService.getScriptLock();


  lock.waitLock(
    15000
  );


  try {

    /* ================================================
       USERS
       ================================================ */

    const users =
      getUsersObjects_();


    const accountNormalized =
      account.toLowerCase();


    let matchedUser =
      null;


    users.some(
      function(user) {

        const userId =
          String(
            user.User_ID || ''
          )
            .trim()
            .toLowerCase();


        const email =
          normalizeEmail_(
            user.Email_Address
          );


        if (
          userId ===
          accountNormalized ||
          email ===
          accountNormalized
        ) {

          matchedUser =
            user;

          return true;

        }


        return false;

      }
    );


    /* ================================================
       ACCOUNT NOT FOUND
       ================================================ */

    if (!matchedUser) {

      throw new Error(
        'The User ID / Mailbox Email or Recovery Email does not match our records.'
      );

    }


    /* ================================================
       CHECK STATUS
       ================================================ */

    const status =
      String(
        matchedUser.Status || ''
      )
        .trim()
        .toUpperCase();


    if (
      status !==
      'ACTIVE'
    ) {

      throw new Error(
        'This mailbox account is not active. Please contact the administrator.'
      );

    }


    /* ================================================
       CHECK RECOVERY EMAIL
       ================================================ */

    const registeredRecoveryEmail =
      normalizeEmail_(
        matchedUser.Recovery_Email
      );


    if (
      !registeredRecoveryEmail
    ) {

      throw new Error(
        'No Recovery Email is registered for this account. Please contact the administrator.'
      );

    }


    if (
      registeredRecoveryEmail !==
      recoveryEmail
    ) {

      throw new Error(
        'The User ID / Mailbox Email or Recovery Email does not match our records.'
      );

    }


    /* ================================================
       OTP SHEET
       ================================================ */

    const sheet =
      getOTPSheet_();


    /*
     * Invalidate any previous active OTP
     * for this user.
     */

    invalidateExistingOTPs_(
      sheet,
      matchedUser.User_ID
    );


    /* ================================================
       GENERATE OTP
       ================================================ */

    const otp =
      generateOTP_();


    const resetId =
      generateResetId_();


    const now =
      new Date();


    const expiry =
      new Date(
        now.getTime() +
        OTP_EXPIRY_MINUTES *
        60 *
        1000
      );


    /* ================================================
       STORE OTP HASH
       ================================================ */

    const row = [

      resetId,

      String(
        matchedUser.User_ID
      ).trim(),

      normalizeEmail_(
        matchedUser.Email_Address
      ),

      registeredRecoveryEmail,

      sha256_(
        otp
      ),

      now,

      expiry,

      0,

      'NO',

      'NO'

    ];


    sheet.appendRow(
      row
    );


    /* ================================================
       SEND EMAIL
       ================================================ */

    const mailboxEmail =
      normalizeEmail_(
        matchedUser.Email_Address
      );


    const fullName =
      clean_(
        matchedUser.Full_Name
      ) ||
      'User';


    const subject =
      'Mailbox Password Reset OTP';


    const plainBody =
      'Dear ' +
      fullName +
      ',\n\n' +

      'Your OTP for resetting your internal mailbox password is:\n\n' +

      otp +
      '\n\n' +

      'This OTP is valid for ' +
      OTP_EXPIRY_MINUTES +
      ' minutes.\n\n' +

      'If you did not request a password reset, please ignore this email and contact the administrator if necessary.\n\n' +

      'Internal Mailbox System';


    const htmlBody =

      '<div style="font-family:Arial,Helvetica,sans-serif;' +
      'background:#f5f7fb;padding:30px;">' +

        '<div style="max-width:600px;margin:auto;' +
        'background:#ffffff;border-radius:14px;' +
        'padding:28px;box-shadow:0 8px 25px rgba(0,0,0,.08);">' +

          '<h2 style="margin-top:0;color:#172033;">' +

            'Mailbox Password Reset' +

          '</h2>' +

          '<p style="color:#475569;">' +

            'Dear ' +
            escapeHtml_(fullName) +
            ',' +

          '</p>' +

          '<p style="color:#475569;">' +

            'Use the following OTP to reset your internal mailbox password:' +

          '</p>' +

          '<div style="font-size:32px;font-weight:bold;' +
          'letter-spacing:8px;text-align:center;' +
          'background:#eff6ff;color:#1d4ed8;' +
          'padding:18px;border-radius:10px;margin:20px 0;">' +

            otp +

          '</div>' +

          '<p style="color:#64748b;">' +

            'This OTP is valid for ' +
            OTP_EXPIRY_MINUTES +
            ' minutes.' +

          '</p>' +

          '<p style="color:#64748b;">' +

            'If you did not request this password reset, ' +
            'please ignore this email.' +

          '</p>' +

          '<hr style="border:0;border-top:1px solid #e2e8f0;">' +

          '<p style="font-size:12px;color:#94a3b8;">' +

            'Internal Mailbox System' +

          '</p>' +

        '</div>' +

      '</div>';


    try {

      MailApp.sendEmail({

        to:
          registeredRecoveryEmail,

        subject:
          subject,

        body:
          plainBody,

        htmlBody:
          htmlBody

      });

    }

    catch (mailError) {

      /*
       * If email sending fails, invalidate
       * the OTP record.
       */

      invalidateResetRecord_(
        sheet,
        resetId
      );


      throw new Error(
        'Unable to send the OTP email. Please try again later.'
      );

    }


    /* ================================================
       RESPONSE
       ================================================ */

    return {

      ok: true,

      resetId:
        resetId,

      maskedEmail:
        maskEmail_(
          registeredRecoveryEmail
        ),

      expiresIn:
        OTP_EXPIRY_MINUTES,

      message:
        'OTP has been sent to your registered Recovery Email.'

    };

  }

  finally {

    lock.releaseLock();

  }

}


/* =====================================================
   VERIFY RESET OTP
   ===================================================== */

function verifyResetOTP(
  data
) {

  data =
    data || {};


  const resetId =
    clean_(
      data.resetId
    );


  const otp =
    String(
      data.otp || ''
    )
      .replace(
        /\D/g,
        ''
      )
      .trim();


  if (!resetId) {

    throw new Error(
      'Reset session is missing. Please request a new OTP.'
    );

  }


  if (
    !/^\d{6}$/.test(
      otp
    )
  ) {

    throw new Error(
      'Please enter the 6-digit OTP.'
    );

  }


  const lock =
    LockService.getScriptLock();


  lock.waitLock(
    15000
  );


  try {

    const sheet =
      getOTPSheet_();


    const record =
      findOTPRecord_(
        sheet,
        resetId
      );


    if (!record) {

      throw new Error(
        'OTP session not found. Please request a new OTP.'
      );

    }


    /* ================================================
       USED
       ================================================ */

    if (
      String(
        record.Used
      ).toUpperCase() ===
      'YES'
    ) {

      throw new Error(
        'This OTP has already been used. Please request a new OTP.'
      );

    }


    /* ================================================
       VERIFIED
       ================================================ */

    if (
      String(
        record.Verified
      ).toUpperCase() ===
      'YES'
    ) {

      return {

        ok: true,

        verified: true,

        resetId:
          resetId,

        message:
          'OTP has already been verified.'

      };

    }


    /* ================================================
       EXPIRY
       ================================================ */

    const expiry =
      new Date(
        record.Expiry_Date
      );


    if (
      isNaN(
        expiry.getTime()
      ) ||
      new Date() >
      expiry
    ) {

      throw new Error(
        'This OTP has expired. Please request a new OTP.'
      );

    }


    /* ================================================
       ATTEMPTS
       ================================================ */

    const attempts =
      Number(
        record.Attempts || 0
      );


    if (
      attempts >=
      OTP_MAX_ATTEMPTS
    ) {

      throw new Error(
        'Maximum OTP verification attempts exceeded. Please request a new OTP.'
      );

    }


    /* ================================================
       COMPARE OTP
       ================================================ */

    const suppliedHash =
      sha256_(
        otp
      );


    const storedHash =
      String(
        record.OTP_Hash || ''
      )
        .trim()
        .toLowerCase();


    if (
      suppliedHash !==
      storedHash
    ) {

      const newAttempts =
        attempts + 1;


      sheet
        .getRange(
          record._rowNumber,
          8
        )
        .setValue(
          newAttempts
        );


      if (
        newAttempts >=
        OTP_MAX_ATTEMPTS
      ) {

        throw new Error(
          'Incorrect OTP. Maximum attempts exceeded. Please request a new OTP.'
        );

      }


      throw new Error(
        'Incorrect OTP. Please try again.'
      );

    }


    /* ================================================
       MARK VERIFIED
       ================================================ */

    sheet
      .getRange(
        record._rowNumber,
        9
      )
      .setValue(
        'YES'
      );


    return {

      ok: true,

      verified: true,

      resetId:
        resetId,

      message:
        'OTP verified successfully.'

    };

  }

  finally {

    lock.releaseLock();

  }

}


/* =====================================================
   RESET PASSWORD
   ===================================================== */

function resetPassword(
  data
) {

  data =
    data || {};


  const resetId =
    clean_(
      data.resetId
    );


  const password =
    String(
      data.password || ''
    );


  const confirmPassword =
    String(
      data.confirmPassword || ''
    );


  if (!resetId) {

    throw new Error(
      'Reset session is missing. Please start the password reset process again.'
    );

  }


  if (
    password.length < 8
  ) {

    throw new Error(
      'Password must contain at least 8 characters.'
    );

  }


  if (
    password !==
    confirmPassword
  ) {

    throw new Error(
      'Password and Confirm Password do not match.'
    );

  }


  /*
   * Optional additional password checks.
   *
   * At least one letter and one number.
   */

  if (
    !/[A-Za-z]/.test(password) ||
    !/\d/.test(password)
  ) {

    throw new Error(
      'Password must contain at least one letter and one number.'
    );

  }


  const lock =
    LockService.getScriptLock();


  lock.waitLock(
    15000
  );


  try {

    /* ================================================
       OTP RECORD
       ================================================ */

    const otpSheet =
      getOTPSheet_();


    const record =
      findOTPRecord_(
        otpSheet,
        resetId
      );


    if (!record) {

      throw new Error(
        'Reset session not found. Please start again.'
      );

    }


    /* ================================================
       VERIFIED
       ================================================ */

    if (
      String(
        record.Verified
      ).toUpperCase() !==
      'YES'
    ) {

      throw new Error(
        'Please verify the OTP before resetting your password.'
      );

    }


    /* ================================================
       USED
       ================================================ */

    if (
      String(
        record.Used
      ).toUpperCase() ===
      'YES'
    ) {

      throw new Error(
        'This reset session has already been used.'
      );

    }


    /* ================================================
       EXPIRY
       ================================================ */

    const expiry =
      new Date(
        record.Expiry_Date
      );


    if (
      isNaN(
        expiry.getTime()
      ) ||
      new Date() >
      expiry
    ) {

      throw new Error(
        'The password reset session has expired. Please request a new OTP.'
      );

    }


    /* ================================================
       USER
       ================================================ */

    const usersSheet =
      getUsersSheet_();


    const users =
      getUsersObjects_();


    const user =
      users.find(
        function(item) {

          return (
            String(
              item.User_ID || ''
            ).trim() ===
            String(
              record.User_ID || ''
            ).trim()
          );

        }
      );


    if (!user) {

      throw new Error(
        'User account could not be found.'
      );

    }


    /* ================================================
       ACCOUNT STATUS
       ================================================ */

    const status =
      String(
        user.Status || ''
      )
        .trim()
        .toUpperCase();


    if (
      status !==
      'ACTIVE'
    ) {

      throw new Error(
        'This mailbox account is not active. Please contact the administrator.'
      );

    }


    /* ================================================
       PREVENT SAME PASSWORD
       ================================================ */

    const newPasswordHash =
      sha256_(
        password
      );


    const currentPasswordHash =
      String(
        user.Password_Hash || ''
      )
        .trim()
        .toLowerCase();


    if (
      currentPasswordHash &&
      currentPasswordHash ===
      newPasswordHash
    ) {

      throw new Error(
        'The new password must be different from your current password.'
      );

    }


    /* ================================================
       PASSWORD COLUMN
       ================================================ */

    const headers =
      getHeaders_(
        usersSheet
      );


    const passwordColumn =
      headers.indexOf(
        'Password_Hash'
      ) + 1;


    if (
      passwordColumn <= 0
    ) {

      throw new Error(
        'Password_Hash column was not found in Users sheet.'
      );

    }


    /* ================================================
       UPDATE PASSWORD
       ================================================ */

    usersSheet
      .getRange(
        user._rowNumber,
        passwordColumn
      )
      .setValue(
        newPasswordHash
      );


    /* ================================================
       RESET LOGIN SECURITY FIELDS
       ================================================ */

    const failedLoginColumn =
      headers.indexOf(
        'Failed_Login_Count'
      ) + 1;


    if (
      failedLoginColumn > 0
    ) {

      usersSheet
        .getRange(
          user._rowNumber,
          failedLoginColumn
        )
        .setValue(
          0
        );

    }


    const lastFailedColumn =
      headers.indexOf(
        'Last_Failed_Login'
      ) + 1;


    if (
      lastFailedColumn > 0
    ) {

      usersSheet
        .getRange(
          user._rowNumber,
          lastFailedColumn
        )
        .clearContent();

    }


    const forcePasswordColumn =
      headers.indexOf(
        'Force_Password_Change'
      ) + 1;


    if (
      forcePasswordColumn > 0
    ) {

      usersSheet
        .getRange(
          user._rowNumber,
          forcePasswordColumn
        )
        .setValue(
          'NO'
        );

    }


    /* ================================================
       MARK OTP USED
       ================================================ */

    otpSheet
      .getRange(
        record._rowNumber,
        10
      )
      .setValue(
        'YES'
      );


    /* ================================================
       INVALIDATE OTHER OTPs
       ================================================ */

    invalidateExistingOTPs_(
      otpSheet,
      user.User_ID
    );


    /*
     * Restore the current record as USED.
     */

    otpSheet
      .getRange(
        record._rowNumber,
        10
      )
      .setValue(
        'YES'
      );


    /* ================================================
       SUCCESS
       ================================================ */

    return {

      ok: true,

      userId:
        String(
          user.User_ID
        ),

      email:
        normalizeEmail_(
          user.Email_Address
        ),

      message:
        'Password has been reset successfully. You can now log in with your new password.'

    };

  }

  finally {

    lock.releaseLock();

  }

}


/* =====================================================
   GET USERS SPREADSHEET
   ===================================================== */

function getUsersSpreadsheet_() {

  return SpreadsheetApp.openById(
    USERS_SPREADSHEET_ID
  );

}


/* =====================================================
   GET USERS SHEET
   ===================================================== */

function getUsersSheet_() {

  const ss =
    getUsersSpreadsheet_();


  let sheet =
    ss.getSheetByName(
      USERS_SHEET_NAME
    );


  if (!sheet) {

    throw new Error(
      'Users sheet was not found.'
    );

  }


  return sheet;

}


/* =====================================================
   GET OTP SHEET
   ===================================================== */

function getOTPSheet_() {

  const ss =
    getUsersSpreadsheet_();


  let sheet =
    ss.getSheetByName(
      OTP_SHEET_NAME
    );


  if (!sheet) {

    sheet =
      ss.insertSheet(
        OTP_SHEET_NAME
      );


    sheet
      .getRange(
        1,
        1,
        1,
        OTP_HEADERS.length
      )
      .setValues([
        OTP_HEADERS
      ]);

  }

  else {

    setupSheetHeaders_(
      sheet,
      OTP_HEADERS
    );

  }


  return sheet;

}


/* =====================================================
   GET USERS
   ===================================================== */

function getUsersObjects_() {

  const sheet =
    getUsersSheet_();


  const lastRow =
    sheet.getLastRow();


  const lastColumn =
    sheet.getLastColumn();


  if (
    lastRow < 2 ||
    lastColumn < 1
  ) {

    return [];

  }


  const values =
    sheet
      .getRange(
        1,
        1,
        lastRow,
        lastColumn
      )
      .getValues();


  const headers =
    values[0];


  return values
    .slice(1)
    .map(
      function(row, index) {

        const obj = {};


        headers.forEach(
          function(header, i) {

            obj[
              String(header)
            ] =
              row[i];

          }
        );


        obj._rowNumber =
          index + 2;


        return obj;

      }
    )
    .filter(
      function(obj) {

        return String(
          obj.User_ID || ''
        ).trim() !== '';

      }
    );

}


/* =====================================================
   GET HEADERS
   ===================================================== */

function getHeaders_(
  sheet
) {

  if (
    sheet.getLastColumn() === 0
  ) {

    return [];

  }


  return sheet
    .getRange(
      1,
      1,
      1,
      sheet.getLastColumn()
    )
    .getValues()[0]
    .map(
      String
    );

}


/* =====================================================
   SETUP HEADERS
   ===================================================== */

function setupSheetHeaders_(
  sheet,
  headers
) {

  if (
    sheet.getLastRow() === 0
  ) {

    sheet
      .getRange(
        1,
        1,
        1,
        headers.length
      )
      .setValues([
        headers
      ]);

    return;

  }


  const current =
    getHeaders_(
      sheet
    );


  const missing =
    headers.filter(
      function(header) {

        return (
          current.indexOf(
            header
          ) === -1
        );

      }
    );


  if (
    missing.length
  ) {

    sheet
      .getRange(
        1,
        current.length + 1,
        1,
        missing.length
      )
      .setValues([
        missing
      ]);

  }

}


/* =====================================================
   FIND OTP RECORD
   ===================================================== */

function findOTPRecord_(
  sheet,
  resetId
) {

  const lastRow =
    sheet.getLastRow();


  const lastColumn =
    sheet.getLastColumn();


  if (
    lastRow < 2 ||
    lastColumn < 1
  ) {

    return null;

  }


  const values =
    sheet
      .getRange(
        1,
        1,
        lastRow,
        lastColumn
      )
      .getValues();


  const headers =
    values[0];


  let found =
    null;


  values
    .slice(1)
    .some(
      function(row, index) {

        const obj = {};


        headers.forEach(
          function(header, i) {

            obj[
              String(header)
            ] =
              row[i];

          }
        );


        obj._rowNumber =
          index + 2;


        if (
          String(
            obj.Reset_ID || ''
          ).trim() ===
          String(
            resetId
          ).trim()
        ) {

          found =
            obj;

          return true;

        }


        return false;

      }
    );


  return found;

}


/* =====================================================
   INVALIDATE EXISTING OTPs
   ===================================================== */

function invalidateExistingOTPs_(
  sheet,
  userId
) {

  const lastRow =
    sheet.getLastRow();


  if (
    lastRow < 2
  ) {

    return;

  }


  const values =
    sheet
      .getRange(
        2,
        1,
        lastRow - 1,
        10
      )
      .getValues();


  const normalizedUserId =
    String(
      userId || ''
    )
      .trim();


  for (
    let i = 0;
    i < values.length;
    i++
  ) {

    const rowUserId =
      String(
        values[i][1] || ''
      ).trim();


    const used =
      String(
        values[i][9] || ''
      )
        .trim()
        .toUpperCase();


    if (
      rowUserId ===
      normalizedUserId &&
      used !==
      'YES'
    ) {

      sheet
        .getRange(
          i + 2,
          10
        )
        .setValue(
          'YES'
        );

    }

  }

}


/* =====================================================
   INVALIDATE RESET RECORD
   ===================================================== */

function invalidateResetRecord_(
  sheet,
  resetId
) {

  const record =
    findOTPRecord_(
      sheet,
      resetId
    );


  if (
    record
  ) {

    sheet
      .getRange(
        record._rowNumber,
        10
      )
      .setValue(
        'YES'
      );

  }

}


/* =====================================================
   GENERATE OTP
   ===================================================== */

function generateOTP_() {

  const min =
    100000;


  const max =
    999999;


  return String(
    Math.floor(
      Math.random() *
      (
        max -
        min +
        1
      )
    ) +
    min
  );

}


/* =====================================================
   GENERATE RESET ID
   ===================================================== */

function generateResetId_() {

  return (
    Utilities.getUuid()
      .replace(
        /-/g,
        ''
      )
      .substring(
        0,
        24
      )
  );

}


/* =====================================================
   MASK EMAIL
   ===================================================== */

function maskEmail_(
  email
) {

  const value =
    normalizeEmail_(
      email
    );


  const parts =
    value.split(
      '@'
    );


  if (
    parts.length !== 2
  ) {

    return 'registered email';

  }


  const local =
    parts[0];


  const domain =
    parts[1];


  if (
    local.length <= 2
  ) {

    return (
      local.charAt(0) +
      '*@' +
      domain
    );

  }


  return (
    local.charAt(0) +
    '*'.repeat(
      Math.min(
        local.length - 2,
        5
      )
    ) +
    local.charAt(
      local.length - 1
    ) +
    '@' +
    domain
  );

}


/* =====================================================
   CLEAN TEXT
   ===================================================== */

function clean_(
  value
) {

  return String(
    value || ''
  )
    .replace(
      /[\u00A0\u200B-\u200D\uFEFF]/g,
      ''
    )
    .trim()
    .replace(
      /\s+/g,
      ' '
    );

}


/* =====================================================
   EMAIL NORMALIZATION
   ===================================================== */

function normalizeEmail_(
  email
) {

  return String(
    email || ''
  )
    .replace(
      /\u00A0/g,
      ' '
    )
    .replace(
      /[\u200B-\u200D\uFEFF]/g,
      ''
    )
    .trim()
    .toLowerCase();

}


/* =====================================================
   EMAIL VALIDATION
   ===================================================== */

function isValidEmail_(
  email
) {

  return /^[^\s@]+@[^\s@]+\.[^\s@]+$/
    .test(
      String(
        email || ''
      )
    );

}


/* =====================================================
   SHA-256
   ===================================================== */

function sha256_(
  text
) {

  const bytes =
    Utilities.computeDigest(
      Utilities.DigestAlgorithm.SHA_256,
      String(text),
      Utilities.Charset.UTF_8
    );


  return bytes
    .map(
      function(b) {

        const value =
          b < 0
            ? b + 256
            : b;


        const hex =
          value.toString(
            16
          );


        return (
          hex.length === 1
            ? '0' + hex
            : hex
        );

      }
    )
    .join('');

}


/* =====================================================
   ESCAPE HTML
   ===================================================== */

function escapeHtml_(
  value
) {

  return String(
    value || ''
  )
    .replace(
      /&/g,
      '&amp;'
    )
    .replace(
      /</g,
      '&lt;'
    )
    .replace(
      />/g,
      '&gt;'
    )
    .replace(
      /"/g,
      '&quot;'
    )
    .replace(
      /'/g,
      '&#039;'
    );

}


/* =====================================================
   ERROR
   ===================================================== */

function errorMessage_(
  error
) {

  if (!error) {

    return 'Unknown error.';

  }


  return (
    error.message ||
    String(error)
  );

}